# Server configuration
PORT=3000
NODE_ENV=development

# Database configuration (PostgreSQL)
# Format: postgresql://username:password@localhost:5432/securejit
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/securejit

# JWT Authentication Secret
JWT_SECRET=CHANGE_THIS_SECRET_IN_PRODUCTION

# Break-glass emergency policy: IMMEDIATE_AUTO_APPROVAL or REQUIRE_ADMIN_APPROVAL
EMERGENCY_POLICY=IMMEDIATE_AUTO_APPROVAL

# Frontend URL for CORS configuration
# In local development: http://localhost:3000
# In production: https://YOUR_DOMAIN.com
FRONTEND_URL=http://localhost:3000

# Optional Azure PIM / Entra ID configuration (for production integration)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
